# Local compose reads these for a barebones dev instance -- no S3, no Pro
# license needed (see docker-compose.yml, which runs the free darthsim/imgproxy
# image locally since dev doesn't need the ML/S3-result-cache Pro features,
# just resize/signing behavior against plain http(s) source URLs).
#
# Production (Dokku) needs the REAL values via `dokku config:set`. Pull them
# off the currently-running container first, don't guess:
#   docker exec <imgproxy_container_id> env | grep IMGPROXY_
# Do NOT commit real secrets to this file or this repo.

# --- Signing (required -- URLs are rejected without a matching key/salt;
# must match what zm/mediary/md send via IMGPROXY_KEY/IMGPROXY_SALT) ---
# IMGPROXY_KEY=
# IMGPROXY_SALT=

# --- Pro license (only needed for the docker.imgproxy.pro image, not local dev) ---
# IMGPROXY_LICENSE_KEY=

# --- Source access ---
IMGPROXY_USE_S3=true
# IMGPROXY_S3_ENDPOINT=
# IMGPROXY_S3_REGION=
# IMGPROXY_S3_ALLOWED_BUCKETS=

# --- Result cache (Pro) -- currently all-or-nothing (everything cached to S3,
# or nothing). Per-preset TTL/control is on imgproxy's 4.1 roadmap; this
# section should grow once we're on that beta. ---
IMGPROXY_CACHE_USE=s3
# IMGPROXY_CACHE_S3_ENDPOINT=
# IMGPROXY_CACHE_S3_REGION=
# IMGPROXY_CACHE_BUCKET=
# IMGPROXY_CACHE_PATH_PREFIX=

# --- Limits / behavior ---
# IMGPROXY_WORKERS=              # size for real load -- the 2026-07 outage
                                  # investigation found "Workers utilization:
                                  # 44/16" (soft-limit overrun) on the old host.
# IMGPROXY_MAX_SRC_FILE_SIZE=
# IMGPROXY_MAX_SRC_RESOLUTION=
# IMGPROXY_ALLOW_ORIGIN=
# IMGPROXY_PRESETS=              # or IMGPROXY_PRESETS_PATH= for a file
# IMGPROXY_ONLY_PRESETS=
# IMGPROXY_ETAG_BUSTER=

# Default User-Agent is "imgproxy/%current_version" -- a generic default that
# Wikimedia's edge blocks/rate-limits per their User-Agent policy
# (https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy, which
# explicitly rejects generic defaults and requires contact info + the word
# "bot"). Found 2026-07-11: wiki/geneva + wiki/iowa (Commons-sourced datasets)
# imgproxy'd thumbnails returned "Source is unreachable" for
# upload.wikimedia.org URLs specifically, while the same URLs fetched fine
# directly (curl) from elsewhere -- consistent with an IP/UA-based block on
# imgproxy's own egress, not a source-side or app-side bug. Matches the UA
# convention already used by survos/wiki-bundle's WikidataService/CommonsService.
IMGPROXY_USER_AGENT="SurvosImgproxyBot/1.0 (+https://survos.com; tac@museado.org) imgproxy/%current_version"
