#!/usr/bin/env python3
"""Assert the server presets match the client bundle's DEFAULT_PRESETS.

imgproxy exposes no endpoint that reports its presets, and the client bundle
expands them inline rather than sending `pr:NAME`. That leaves two halves of
one contract in two repos. This fails loudly when they drift.

    bin/check-presets-sync [path-to-imgproxy-bundle]

Exit 0 = in sync, 1 = drift. Suitable for CI or a pre-release check.
"""
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
BUNDLE = Path(sys.argv[1] if len(sys.argv) > 1
              else Path.home() / "sites/mono/bu/imgproxy-bundle")


def server_presets() -> dict[str, str]:
    out = subprocess.run([str(HERE / "bin/presets"), "--full"],
                         capture_output=True, text=True, check=True).stdout
    return dict(line.split("=", 1) for line in out.strip().splitlines())


def bundle_presets() -> dict[str, str]:
    php = (BUNDLE / "src/SurvosImgproxyBundle.php").read_text()
    block = php.split("DEFAULT_PRESETS = [")[1].split("];")[0]
    out = {}
    for m in re.finditer(r"'(\w+)'\s*=>\s*\[([^\]]+)\]", block):
        name, body = m.group(1), m.group(2)
        g = dict(re.findall(r"'(\w+)'\s*=>\s*'?(\w+)'?", body))
        # mirror ImgproxyUrlBuilder::resizePreset() exactly: rs / q / sm / f
        opts = f"rs:{g.get('resize', 'fit')}:{g['width']}:{g['height']}:0:0"
        if g.get("quality"):
            opts += f"/q:{g['quality']}"
        if "strip_metadata" in g:
            opts += f"/sm:{1 if g['strip_metadata'] == 'true' else 0}"
        opts += f"/f:{g.get('format', 'jpg')}"
        out[name] = opts
    return out


def main() -> int:
    if not BUNDLE.exists():
        print(f"bundle not found at {BUNDLE}", file=sys.stderr)
        return 2
    srv, cli = server_presets(), bundle_presets()
    drift = []
    for name in sorted(set(srv) | set(cli)):
        s, c = srv.get(name), cli.get(name)
        if s != c:
            drift.append((name, s, c))
    if not drift:
        print(f"presets in sync ({len(srv)}): {', '.join(sorted(srv))}")
        return 0
    print(f"PRESET DRIFT ({len(drift)} of {len(set(srv) | set(cli))}):", file=sys.stderr)
    for name, s, c in drift:
        print(f"  {name}", file=sys.stderr)
        print(f"    Dockerfile: {s or '(missing)'}", file=sys.stderr)
        print(f"    bundle:     {c or '(missing)'}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
