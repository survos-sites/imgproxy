#!/usr/bin/env python3
"""Assert the server presets cover every client definition, byte for byte.

imgproxy exposes no endpoint that reports its presets, and the client bundle
expands them inline rather than sending `pr:NAME`. That leaves the halves of one
contract spread across several repos. This fails loudly when they drift.

Checked sources:
  * mono/bu/imgproxy-bundle  SurvosImgproxyBundle::DEFAULT_PRESETS
  * each app's              config/packages/survos_imgproxy.yaml

An app's `survos_imgproxy.presets` REPLACES the bundle default wholesale rather
than merging, so apps restate the defaults verbatim. A stale restatement is
exactly the drift this catches.

    bin/check-presets-sync [--apps DIR ...]

Exit 0 = every client definition matches the server. Exit 1 = drift.
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
SITES = Path.home() / "sites"
BUNDLE = SITES / "mono/bu/imgproxy-bundle/src/SurvosImgproxyBundle.php"
APPS = [SITES / a / "config/packages/survos_imgproxy.yaml"
        for a in ("openfoto", "zm", "mediary", "md")]


def opts(g: dict[str, str]) -> str:
    """Mirror ImgproxyUrlBuilder::resizePreset() exactly: rs / q / sm / f."""
    s = f"rs:{g.get('resize', 'fit')}:{g['width']}:{g['height']}:0:0"
    if g.get("quality"):
        s += f"/q:{g['quality']}"
    if "strip_metadata" in g:
        s += f"/sm:{1 if str(g['strip_metadata']).lower() == 'true' else 0}"
    s += f"/f:{g.get('format', 'jpg')}"
    return s


def server_presets() -> dict[str, str]:
    out = subprocess.run([str(HERE / "bin/presets"), "--full"],
                         capture_output=True, text=True, check=True).stdout
    return dict(l.split("=", 1) for l in out.strip().splitlines())


def bundle_presets() -> dict[str, str]:
    if not BUNDLE.exists():
        return {}
    block = BUNDLE.read_text().split("DEFAULT_PRESETS = [")[1].split("];")[0]
    return {m.group(1): opts(dict(re.findall(r"'(\w+)'\s*=>\s*'?(\w+)'?", m.group(2))))
            for m in re.finditer(r"'(\w+)'\s*=>\s*\[([^\]]+)\]", block)}


def yaml_presets(path: Path) -> dict[str, str]:
    """Minimal parser — avoids a PyYAML dependency for a fixed 2-level shape."""
    if not path.exists():
        return {}
    lines = path.read_text().splitlines()
    out, cur, base = {}, None, None
    for raw in lines:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip())
        line = raw.strip()
        if line.endswith(":") and ":" not in line[:-1]:
            name = line[:-1]
            if name in ("survos_imgproxy", "presets"):
                base = None
                continue
            if base is None:
                base = indent
            if indent == base:
                cur = name
                out[cur] = {}
            continue
        if cur and ":" in line:
            k, v = (x.strip() for x in line.split(":", 1))
            out[cur][k] = v
    return {k: opts(v) for k, v in out.items() if "width" in v}


def main() -> int:
    srv = server_presets()
    problems: list[str] = []

    sources: list[tuple[str, dict[str, str]]] = [("bundle default", bundle_presets())]
    for p in APPS:
        d = yaml_presets(p)
        if d:
            sources.append((p.parts[-4], d))

    for label, cli in sources:
        for name, want in sorted(cli.items()):
            got = srv.get(name)
            if got is None:
                problems.append(f"  {label}: '{name}' MISSING from server\n"
                                f"      client: {want}")
            elif got != want:
                problems.append(f"  {label}: '{name}' DIFFERS\n"
                                f"      server: {got}\n"
                                f"      client: {want}")
        print(f"  {label:<16} {len(cli)} preset(s) checked")

    unused = sorted(set(srv) - {n for _, c in sources for n in c})
    if unused:
        print(f"  (server-only, unused by any client: {', '.join(unused)})")

    if problems:
        print(f"\nPRESET DRIFT ({len(problems)}):", file=sys.stderr)
        print("\n".join(problems), file=sys.stderr)
        return 1
    print(f"\n  all client presets match the server ({len(srv)} defined)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
